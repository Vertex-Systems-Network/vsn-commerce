{
  "name": "vsn-ecommerce",
  "private": true,
  "version": "4.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/verify-built-assets.mjs",
    "preview": "vite preview",
    "dev:vite": "vite --host 0.0.0.0",
    "e2e": "npm run e2e:bootstrap && npm run build && playwright test",
    "e2e:ci": "npm run build && playwright test --project=chromium --project=mobile-chromium",
    "e2e:quality": "npm run e2e:bootstrap && npm run build && playwright test e2e/accessibility.spec.js e2e/w3c.spec.js e2e/interaction-quality.spec.js --project=chromium",
    "e2e:smoke": "npm run build && playwright test --grep @smoke --project=chromium",
    "e2e:cross-browser": "npm run build && playwright test --project=firefox-smoke --project=webkit-smoke",
    "e2e:headed": "npm run build && playwright test --project=chromium --headed",
    "e2e:ui": "npm run build && playwright test --ui",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:install": "playwright install chromium firefox webkit",
    "e2e:bootstrap": "npm install --no-save --package-lock=false @playwright/test@1.62.1 @axe-core/playwright@4.13.0 vnu-jar@26.8.21",
    "e2e:run": "playwright test",
    "test": "node scripts/frontend-test.mjs && php scripts/audit-routing-deployment.php",
    "test:build": "npm run build",
    "audit:documentation": "node scripts/audit-code-documentation.cjs",
    "audit:file-names": "php scripts/audit-file-names.php",
    "audit:wave": "node scripts/wave-audit.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.9.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "sass": "^1.93.0"
  }
}
