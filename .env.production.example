VSN_CARD_PAYMENT_PROVIDER=
VSN_STANDARD_SHIPPING_PROVIDER=
VSN_EXPRESS_SHIPPING_PROVIDER=
VSN_KYC_PROVIDER=

VITE_VSN_API_BASE=
VITE_VSN_BACKEND=laravel

VSN_ACCEPTANCE_REQUIRE_DISTINCT_SIGNERS=true
VSN_ACCEPTANCE_RUNTIME_EVIDENCE_MAX_AGE_MINUTES=180
VSN_ACCEPTANCE_VERIFICATION_MANIFEST=/var/www/vsn/shared/runtime/final-acceptance-verification.json
VSN_RELEASE_CANDIDATE_MANIFEST=/var/www/vsn/shared/runtime/final-release-candidate.json

# AZ — go-live stabilization
VSN_GO_LIVE_ROLLBACK_WINDOW_MINUTES=120
VSN_GO_LIVE_STABILIZATION_MINUTES=240
VSN_GO_LIVE_OBSERVATION_INTERVAL_MINUTES=5
VSN_GO_LIVE_REQUIRED_HEALTHY_OBSERVATIONS=6
VSN_GO_LIVE_MAX_FAILED_JOBS=0
VSN_GO_LIVE_MAX_NOTIFICATION_FAILED=0
VSN_GO_LIVE_MAX_NOTIFICATION_BACKLOG=500
VSN_GO_LIVE_MAX_PAYMENT_FAILURE_PERCENT=10
VSN_GO_LIVE_PAYMENT_FAILURE_MIN_ATTEMPTS=10
VSN_GO_LIVE_MAX_SEV3_INCIDENTS=2
VSN_GO_LIVE_PROVIDER_HEALTH_MAX_AGE_MINUTES=15
VSN_GO_LIVE_FINANCE_RECONCILIATION_MAX_AGE_MINUTES=75
VSN_GO_LIVE_AUTO_OPEN_INCIDENT=true
VSN_GO_LIVE_REQUIRE_DISTINCT_SIGNERS=true
