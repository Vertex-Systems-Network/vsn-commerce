APP_NAME="VSN Ecommerce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
FRONTEND_URL=
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vsn_ecommerce
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
CACHE_LIMITER_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_RETRY_AFTER=1200

VSN_RELEASE=
VSN_DEMO_SEED_ENABLED=false
VSN_HEALTH_REQUIRE_SCHEDULER=true
VSN_HEALTH_REQUIRE_QUEUE_WORKER=true
VSN_HEALTH_REQUIRE_QUEUE_PRESSURE=true
VSN_QUEUE_BUSY_MAX=500
VSN_ASYNC_SCHEDULER=true
VSN_BACKUPS_ENABLED=true
VSN_BACKUP_DISK=s3
VSN_BACKUP_RETENTION_DAYS=30
VSN_DEPLOY_REQUIRE_VERIFIED_BACKUP=true
VSN_DEPLOY_REQUIRE_ARTIFACT_SHA=true
VSN_DEPLOY_REQUIRE_DEPENDENCY_LOCKS=true
VSN_DEPLOY_AUTO_ROLLBACK=true
VSN_DEPLOY_SERVICE_RESTART_COMMAND=
VSN_DEPLOY_READINESS_TIMEOUT_SECONDS=120
VSN_DEPLOY_READINESS_POLL_SECONDS=5
VSN_LAUNCH_MAX_FAILED_JOBS=0
VSN_LAUNCH_BACKUP_MAX_AGE_HOURS=30
VSN_LAUNCH_REQUIRE_VERIFICATION_MANIFEST=true
VSN_LAUNCH_VERIFICATION_MANIFEST=/var/www/vsn/shared/runtime/launch-verification.json

VSN_SANDBOX_PAYMENT_SIMULATOR_ENABLED=false
VSN_SANDBOX_PAYMENT_VAULT_SIMULATOR_ENABLED=false
VSN_SANDBOX_SHIPPING_SIMULATOR_ENABLED=false
VSN_SANDBOX_SMS_ENABLED=false
VSN_CSP_ENABLED=true

MAIL_MAILER=
MAIL_FROM_ADDRESS=
VSN_TRANSACTIONAL_EMAIL_PROVIDER=
VSN_SMS_PROVIDER=
