<IfModule mod_rewrite.c>
    RewriteEngine On

    # Compatibility shim for local Apache/Laragon hosts whose DocumentRoot was
    # accidentally pointed at the repository root instead of the public folder.
    # Production should still point DocumentRoot directly to <project>/public.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
