APP_NAME="VSN Ecommerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vsn_ecommerce
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000,localhost,127.0.0.1

CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VSN_CURRENCY=PKR
VSN_COINS_PER_RUPEE=70
VSN_INVENTORY_RESERVATION_MINUTES=15

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
# Payments: sandbox is for local/development testing only.
VSN_CARD_PAYMENTS_ENABLED=false
VSN_CARD_PAYMENT_PROVIDER=sandbox
VSN_SANDBOX_PAYMENT_WEBHOOK_SECRET=local-sandbox-webhook-secret-change-me
VSN_SANDBOX_PAYMENT_SIMULATOR_ENABLED=false


# VSN wallet
VSN_DAILY_CHECKIN_COINS=70
VSN_SEVEN_DAY_BONUS_COINS=350
VSN_MAX_COIN_PURCHASE=7000000
VSN_COIN_PURCHASE_PAYMENT_MINUTES=30
VSN_PROMOTIONAL_COIN_EXPIRY_DAYS=365
VSN_COIN_EXPIRY_BATCH_SIZE=500

# Affiliate
VSN_AFFILIATE_HOLD_DAYS=14
VSN_AFFILIATE_TERMS_VERSION=2026-08

# Game Win
VSN_GAME_RULES_VERSION=2026-08
VSN_GAME_MAX_ENTRIES_PER_REQUEST=20
VSN_GAME_MAX_ENTRIES_PER_USER=100
VSN_GAME_REFUND_BATCH_SIZE=200

# Returns
VSN_RETURN_WINDOW_DAYS=30

# Gifts
VSN_GIFT_WRAP_MINOR=29900
VSN_GIFT_MAX_SCHEDULE_DAYS=90
VSN_GIFT_COD_ENABLED=false

# Verified reviews & review reward coupons
VSN_REVIEW_REWARD_PERCENT_BPS=1000
VSN_REVIEW_COUPON_EXPIRY_DAYS=90
VSN_REVIEW_REMINDER_DELAY_DAYS=2
VSN_REVIEW_IMAGE_DISK=public

VSN_SELLER_PAYOUT_HOLD_DAYS=30
VSN_MINIMUM_PAYOUT_MINOR=100000
VSN_REQUIRE_VERIFIED_PAYOUT_METHOD=true
VSN_PAYOUT_MAX_RETRIES=3
VSN_REVIEW_COUPON_SUBSIDY_BEARER=platform

# Shipping / courier
VSN_SANDBOX_SHIPPING_WEBHOOK_SECRET=change-me-in-local-env
VSN_SANDBOX_SHIPPING_SIMULATOR_ENABLED=false
VSN_STANDARD_SHIPPING_PROVIDER=sandbox
VSN_STANDARD_DISPATCH_SLA_HOURS=24
VSN_STANDARD_DELIVERY_SLA_HOURS=120
VSN_EXPRESS_SHIPPING_PROVIDER=sandbox
VSN_EXPRESS_DISPATCH_SLA_HOURS=12
VSN_EXPRESS_DELIVERY_SLA_HOURS=48

# Notifications & messaging
VSN_NOTIFICATION_BACKFILL_DAYS=30
VSN_NOTIFICATION_DELIVERY_BATCH_SIZE=200
VSN_MESSAGE_ATTACHMENT_DISK=local
VSN_MESSAGE_POLL_SECONDS=12

# Realtime broadcasting: null keeps polling-only mode; set reverb after installing laravel/reverb.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VSN_KYC_DOCUMENT_DISK=local
VSN_SANDBOX_SMS_ENABLED=false
VSN_PAYOUT_REQUIRE_PHONE_VERIFICATION=true
VSN_PAYOUT_REQUIRE_IDENTITY_KYC=true

VSN_SEARCH_PER_PAGE=24
VSN_PRODUCT_ALERT_SCAN_LIMIT=1000

# Milestone Q product media / personalization
VSN_PRODUCT_MEDIA_DISK=public
VSN_MAX_PRODUCT_IMAGES=10
VSN_PRODUCT_VIEW_DEDUP_MINUTES=30
VSN_PRODUCT_VIEW_RETENTION_DAYS=180

# Tax/VAT/GST engine: rates are configured in Admin Tax, never hard-coded here.
VSN_TAX_ENABLED=false
VSN_TAX_DEFAULT_COLLECTION_MODE=none
VSN_TAX_DEFAULT_PRICES_INCLUDE_TAX=false
VSN_TAX_SHIPPING_PRICES_INCLUDE_TAX=false
VSN_TAX_INVOICE_PREFIX=INV
VSN_TAX_CREDIT_NOTE_PREFIX=CN
VSN_TAX_INVOICE_EXPOSE_FULL_TAX_ID=false


# Risk / fraud controls (score defaults to observation; holds + velocities are enforced)
VSN_RISK_MODE=observe
VSN_RISK_REVIEW_SCORE=50
VSN_RISK_CRITICAL_SCORE=75
VSN_RISK_AUTO_HOLD_CRITICAL=false
VSN_RISK_PAYMENT_INTENTS_PER_15M=8
VSN_RISK_WALLET_TRANSFERS_PER_HOUR=10
VSN_RISK_WALLET_TRANSFER_COINS_PER_DAY=350000
VSN_RISK_GAME_ENTRIES_PER_HOUR=100
VSN_RISK_RETURN_REQUESTS_PER_DAY=5
VSN_RISK_SIGNAL_WALLET_COINS_24H=175000
VSN_RISK_SIGNAL_GAME_ENTRIES_24H=150

# Reporting / private BI exports
VSN_REPORTING_TIMEZONE=Asia/Karachi
VSN_REPORT_EXPORT_DISK=local
VSN_REPORT_EXPORT_RETENTION_DAYS=14
VSN_REPORT_MAX_DASHBOARD_DAYS=366
VSN_REPORT_MAX_EXPORT_ROWS=100000
VSN_REPORT_MAX_COHORT_CUSTOMERS=50000
VSN_REPORT_GENERATE_BATCH_SIZE=10
VSN_REPORT_SCHEDULE_BATCH_SIZE=100

# Production hardening / operations
VSN_RELEASE=0.34.0
VSN_HEALTH_DISK=local
VSN_HEALTH_REQUIRE_SCHEDULER=false
VSN_HEALTH_REQUIRE_QUEUE_WORKER=false
VSN_HEALTH_REQUIRE_QUEUE_PRESSURE=false
VSN_SCHEDULER_STALE_SECONDS=180
VSN_QUEUE_WORKER_STALE_SECONDS=180
VSN_SLOW_QUERY_MS=500
VSN_MONITORED_QUEUES=critical,maintenance,default,notifications,reports
VSN_QUEUE_BUSY_MAX=500
VSN_DEPLOY_REQUIRE_VERIFIED_BACKUP=true
VSN_DEPLOY_REQUIRE_ARTIFACT_SHA=true
VSN_DEPLOY_REQUIRE_DEPENDENCY_LOCKS=true
VSN_DEPLOY_MAX_ACTIVE_INCIDENT_SEVERITY=sev3
VSN_ASYNC_SCHEDULER=false
VSN_RATE_GUEST_PER_MINUTE=180
VSN_RATE_AUTHENTICATED_PER_MINUTE=600
VSN_RATE_AUTH_PER_MINUTE=30
VSN_RATE_CATALOG_READ_PER_MINUTE=240
VSN_RATE_COMMERCE_WRITE_PER_MINUTE=90
VSN_RATE_UPLOAD_PER_MINUTE=20
VSN_RATE_WEBHOOK_PER_MINUTE=300
VSN_RATE_SENSITIVE_PER_MINUTE=12
VSN_QUERY_TELEMETRY_ENABLED=true
VSN_REQUEST_BUDGET_MS=1500
VSN_QUERY_BUDGET=80
VSN_DUPLICATE_QUERY_BUDGET=8
VSN_MEMORY_BUDGET_MB=96
VSN_EXPOSE_SERVER_TIMING=false
VSN_CATALOG_CACHE_SECONDS=120
VSN_SEARCH_SUGGESTION_CACHE_SECONDS=30
VSN_TRENDING_CACHE_SECONDS=60
VSN_MAX_API_REQUEST_BYTES=2097152
VSN_MAX_UPLOAD_REQUEST_BYTES=52428800
VSN_UPLOAD_MAX_FILE_BYTES=10485760
VSN_UPLOAD_MAX_IMAGE_DIMENSION=12000
VSN_UPLOAD_MAX_IMAGE_PIXELS=50000000
VSN_CSP_ENABLED=true
CACHE_LIMITER_STORE=file
REDIS_QUEUE_RETRY_AFTER=1200
QUEUE_FAILED_DRIVER=database-uuids

# Backups are safe-off until a private disk and database dump binary are configured.
VSN_BACKUPS_ENABLED=false
VSN_BACKUP_DISK=local
VSN_BACKUP_RETENTION_DAYS=14
VSN_LAUNCH_MAX_FAILED_JOBS=0
VSN_LAUNCH_BACKUP_MAX_AGE_HOURS=30
VSN_LAUNCH_REQUIRE_VERIFICATION_MANIFEST=false
VSN_LAUNCH_VERIFICATION_MANIFEST=/var/www/html/runtime/launch-verification.json
VSN_BACKUP_TIMEOUT_SECONDS=600
VSN_MYSQL_DUMP_BINARY=mysqldump
VSN_MYSQL_DUMP_NO_TABLESPACES=true
VSN_PG_DUMP_BINARY=pg_dump


# Only list your load balancer / reverse-proxy IPs or CIDRs; never blindly trust all proxies.
TRUSTED_PROXIES=

# Milestone X live provider adapters (safe-off until credentials are supplied)
# Stripe: PaymentIntent + signed webhook + provider-token vault.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Twilio Programmable Messaging.
VSN_SMS_PROVIDER=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_BASE=https://api.twilio.com

# Transactional email. laravel_mail uses MAIL_*; resend uses the API directly for marketplace deliveries.
VSN_TRANSACTIONAL_EMAIL_PROVIDER=laravel_mail
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_API_BASE=https://api.resend.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls

# Normalized production courier connector. Must expose the contract in docs/PROVIDER-RUNTIME-CONTRACTS.md.
VSN_COURIER_API_BASE_URL=
VSN_COURIER_API_TOKEN=
VSN_COURIER_WEBHOOK_SECRET=
VSN_COURIER_CREATE_PATH=/shipments
VSN_COURIER_LOOKUP_PATH=/shipments/{id}
VSN_COURIER_HEALTH_PATH=/health

# Normalized KYC connector. Manual remains the default until a provider is selected/configured.
VSN_KYC_PROVIDER=manual
VSN_KYC_API_BASE_URL=
VSN_KYC_API_TOKEN=
VSN_KYC_WEBHOOK_SECRET=
VSN_KYC_SUBMIT_PATH=/verifications
VSN_KYC_LOOKUP_PATH=/verifications/{id}
VSN_KYC_HEALTH_PATH=/health

VSN_PROVIDER_HEALTH_MAX_AGE_MINUTES=15
VSN_PROVIDER_RECONCILIATION_LIMIT=200
VSN_PROVIDER_RECONCILIATION_MAX_AGE_HOURS=24

# Legacy WordPress/WooCommerce migration bridge (Milestone Y)


# Milestone Z — production acceptance / DR / final closure
VSN_ACCEPTANCE_VALID_MINUTES=120
VSN_ACCEPTANCE_DRILL_MAX_AGE_DAYS=90
VSN_ACCEPTANCE_RTO_TARGET_MINUTES=60
VSN_ACCEPTANCE_RPO_TARGET_MINUTES=1440
VSN_ACCEPTANCE_MAX_PRODUCT_VIEW_RETENTION_DAYS=365
VSN_ACCEPTANCE_MAX_REPORT_RETENTION_DAYS=30
# Enable only after archive + bridge removal + migration-secret rotation are part of your final closure policy.
VSN_ACCEPTANCE_REQUIRE_DISTINCT_SIGNERS=false
VSN_ACCEPTANCE_RUNTIME_EVIDENCE_MAX_AGE_MINUTES=180
VSN_ACCEPTANCE_VERIFICATION_MANIFEST=runtime/final-acceptance-verification.json
VSN_RELEASE_CANDIDATE_MANIFEST=runtime/final-release-candidate.json

# Android / mobile API (Milestone AA)
VSN_MOBILE_ACCESS_TOKEN_MINUTES=60
VSN_MOBILE_REFRESH_TOKEN_DAYS=30
VSN_ANDROID_MINIMUM_VERSION=1.0.0
VSN_ANDROID_LATEST_VERSION=1.0.0
VSN_ANDROID_MINIMUM_SDK=26
VSN_ANDROID_STORE_URL=
VSN_MOBILE_MAINTENANCE_ENABLED=false
VSN_MOBILE_MAINTENANCE_MESSAGE=
VSN_MOBILE_MAINTENANCE_RETRY_AFTER_SECONDS=300
VSN_ANDROID_OAUTH_APP_CALLBACK_URL=
VSN_ANDROID_NOTIFICATION_CHANNEL=vsn_general
VSN_FCM_TIMEOUT_SECONDS=10
FCM_PROJECT_ID=
# Keep the Firebase service-account JSON outside public/ and outside source control.
FCM_SERVICE_ACCOUNT_PATH=storage/app/private/firebase-service-account.json
VSN_MOBILE_AUTH_PER_MINUTE=20
VSN_MOBILE_REFRESH_PER_MINUTE=30
# Unified Laravel + React application
# Keep blank for same-origin API calls (recommended).
VITE_VSN_API_BASE=
VITE_VSN_REQUIRE_AUTH=false
# Development HMR host only; production does not use a separate frontend host.
VITE_DEV_HOST=localhost

# Payment/shipping lifecycle
VSN_PAYMENT_MAX_INITIALIZATION_ATTEMPTS=3
VSN_COURIER_CANCEL_PATH=/shipments/{id}/cancel
VSN_SHIPPING_MAX_CREATION_ATTEMPTS=5

# KYC / Security / Notification lifecycle
VSN_KYC_GOVERNMENT_ID_VALID_DAYS=365
VSN_KYC_ADDRESS_PROOF_VALID_DAYS=180
VSN_KYC_RETRY_BATCH_SIZE=100
VSN_NOTIFICATION_MAX_ATTEMPTS=3

VSN_KYC_MAX_PROVIDER_ATTEMPTS=5

# Search / review / media lifecycle
VSN_SEARCH_HISTORY_RETENTION_DAYS=90
VSN_TRENDING_SEARCH_MIN_COUNT=3

# Local/demo data. Keep false in production.
VSN_DEMO_SEED_ENABLED=true

# AZ — go-live stabilization
VSN_GO_LIVE_ROLLBACK_WINDOW_MINUTES=120
VSN_GO_LIVE_STABILIZATION_MINUTES=240
VSN_GO_LIVE_OBSERVATION_INTERVAL_MINUTES=5
VSN_GO_LIVE_REQUIRED_HEALTHY_OBSERVATIONS=6
VSN_GO_LIVE_MAX_FAILED_JOBS=0
VSN_GO_LIVE_MAX_NOTIFICATION_FAILED=0
VSN_GO_LIVE_MAX_NOTIFICATION_BACKLOG=500
VSN_GO_LIVE_MAX_PAYMENT_FAILURE_PERCENT=10
VSN_GO_LIVE_PAYMENT_FAILURE_MIN_ATTEMPTS=10
VSN_GO_LIVE_MAX_SEV3_INCIDENTS=2
VSN_GO_LIVE_PROVIDER_HEALTH_MAX_AGE_MINUTES=15
VSN_GO_LIVE_FINANCE_RECONCILIATION_MAX_AGE_MINUTES=75
VSN_GO_LIVE_AUTO_OPEN_INCIDENT=true
VSN_GO_LIVE_REQUIRE_DISTINCT_SIGNERS=true
VSN_GO_LIVE_REQUIRED_SIGNOFFS=operations,finance,business_owner
